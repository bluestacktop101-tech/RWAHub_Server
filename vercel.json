{
  "framework": "tanstack-start",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rwahubassets.com"
        }
      ],
      "destination": "rwahubassets.com"
    }
  ]
}